{
  "name": "mern-integrations",
  "version": "1.0.0",
  "description": "Reusable backend integration library for MERN stack applications",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "example:razorpay": "node examples/razorpay-example.js",
    "example:ccavenue": "node examples/ccavenue-example.js",
    "example:stripe": "node examples/stripe-example.js",
    "example:resend": "node examples/resend-example.js",
    "example:nodemailer": "node examples/nodemailer-example.js",
    "example:ses": "node examples/ses-example.js",
    "example:msg91": "node examples/msg91-example.js",
    "example:messagebird": "node examples/messagebird-example.js",
    "example:cloudinary": "node examples/cloudinary-example.js",
    "example:s3": "node examples/s3-example.js"
  },
  "keywords": [
    "mern",
    "integration",
    "payments",
    "razorpay"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/client-ses": "^3.1126.0",
    "@aws-sdk/lib-storage": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "nodemailer": "^10.0.0",
    "razorpay": "^2.9.5",
    "resend": "^6.26.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
