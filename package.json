{
  "name": "mern-integrations",
  "version": "1.0.0",
  "description": "Unified, production-ready backend integration library for MERN stack applications covering Payments, Email, SMS/OTP, and Storage",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./payments": "./src/payments/index.js",
    "./email": "./src/email/index.js",
    "./sms": "./src/sms/index.js",
    "./storage": "./src/storage/index.js",
    "./testing": "./src/testing/index.js",
    "./middleware": "./src/middleware/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mern-integrations": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "cli": "node ./bin/cli.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "example:razorpay": "node examples/payments/razorpay.example.js",
    "example:ccavenue": "node examples/payments/ccavenue.example.js",
    "example:stripe": "node examples/payments/stripe.example.js",
    "example:resend": "node examples/email/resend.example.js",
    "example:nodemailer": "node examples/email/nodemailer.example.js",
    "example:ses": "node examples/email/ses.example.js",
    "example:msg91": "node examples/sms/msg91.example.js",
    "example:messagebird": "node examples/sms/messagebird.example.js",
    "example:twilio": "node examples/sms/twilio.example.js",
    "example:phonepe": "node examples/payments/phonepe.example.js",
    "example:cloudinary": "node examples/storage/cloudinary.example.js",
    "example:s3": "node examples/storage/s3.example.js",
    "example:idempotency": "node examples/middleware/idempotency.example.js",
    "example:webhook-normalizer": "node examples/middleware/webhook-normalizer.example.js"
  },
  "keywords": [
    "mern",
    "integration",
    "cli",
    "scaffolder",
    "payments",
    "email",
    "sms",
    "otp",
    "storage",
    "razorpay",
    "ccavenue",
    "stripe",
    "phonepe",
    "resend",
    "nodemailer",
    "ses",
    "msg91",
    "messagebird",
    "twilio",
    "cloudinary",
    "s3",
    "aws"
  ],
  "author": "Muttu Karani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuttuKarani/mern-integrations.git"
  },
  "bugs": {
    "url": "https://github.com/MuttuKarani/mern-integrations/issues"
  },
  "homepage": "https://github.com/MuttuKarani/mern-integrations#readme",
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "cloudinary": "^1.0.0 || ^2.0.0",
    "nodemailer": "^6.0.0 || ^7.0.0 || ^10.0.0",
    "razorpay": "^2.0.0",
    "resend": "^3.0.0 || ^4.0.0 || ^6.0.0",
    "stripe": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-ses": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "cloudinary": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "razorpay": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "jest": "^30.5.2",
    "nodemailer": "^10.0.1",
    "razorpay": "^2.9.5",
    "resend": "^6.26.0",
    "stripe": "^22.6.1"
  }
}
